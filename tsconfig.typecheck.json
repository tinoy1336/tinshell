{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Type-check-only program. The shim specifiers resolve to the declarations in
    // shim-types/ (generated by `npm run gen:shim-types`), so tsc checks THIS repo's
    // sources while skipLibCheck keeps the third-party .ts sources out of the
    // program. tsconfig.json — the config `ags bundle` reads for runtime resolution
    // — deliberately carries no such mapping: pointing the bundler at declarations
    // would break every app at runtime.
    "paths": {
      "@apps/*": ["./apps/*"],
      "@common/*": ["./common/*"],
      "ags": ["./shim-types/lib/index.d.ts"],
      "ags/*": ["./shim-types/lib/*"],
      "gnim": ["./shim-types/node_modules/gnim/dist/index.d.ts"],
      "gnim/*": ["./shim-types/node_modules/gnim/dist/*"]
    }
  },
  "include": ["apps/**/*", "common/**/*", "typing-fixes.d.ts", "env.d.ts", "@girs/**/*"]
}
