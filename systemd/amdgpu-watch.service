# TINSHELL amdgpu-watch user service (amdgpu-watch.service) — dock-local helper
# (apps/dock/amdgpu-watch.sh): watches the kernel journal for amdgpu ring
# timeouts / GPU resets and copies the devcoredump before it expires.
#
# This file is a TEMPLATE: setup.sh substitutes __TREE__ with the tree's install
# location and __HOME__ with the real $HOME.

[Unit]
Description=amdGPU ring-timeout / GPU-reset watchdog (copies devcoredumps before expiry)
After=default.target

[Service]
Type=simple
ExecStart=__TREE__/apps/dock/amdgpu-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
