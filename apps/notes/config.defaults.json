{
  "appearance": {
    "cardColour": "#0a0c11",
    "cardAlpha": 0.5,
    "textColour": "#e6e6e6",
    "caretColour": "#8ab5f7",
    "selectionColour": "rgba(138, 181, 247, 0.45)",
