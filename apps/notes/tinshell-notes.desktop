# This file is a TEMPLATE: setup.sh substitutes __TREE__ with the tree's install
# location and __HOME__ with the real $HOME.
[Desktop Entry]
Type=Application
Version=1.0
Name=TINSHELL Notes
GenericName=Notes
Comment=TINSHELL floating desktop notes
Exec=__TREE__/apps/notes/ensure-open.sh %f
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;
# Markdown only. Plain text is the system's fallback type for almost every
# source file — .go, .sql, .yaml, .toml, .lua, .ini and .txt all report
# text/plain — so claiming it here would open source files in a notes app.
MimeType=text/markdown;
StartupNotify=false
