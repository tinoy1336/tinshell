        "confirmation code",
        "access code",
        "temporary code",
        "single-use code",
        "single use code",
        "temporary password",
        "magic link"
      ],
      "weak": [
        "verification",
        "verify",
        "pin",
        "security",
        "authenticate",
        "authentication",
        "sign in",
        "sign-in",
        "log in",
        "login"
